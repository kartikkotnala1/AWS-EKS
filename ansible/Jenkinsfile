pipeline {
    agent any
    parameters {
        choice(
            name: 'ACTION',
            choices: ['deploy', 'remove'],
            description: 'Select deploy to run playbook or remove to clean up resources'
        )
        string(
            name: 'REPLICAS',
            defaultValue: '2',
            description: 'Number of NGINX pod replicas to deploy'
        )
    }
    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('Configure Kubeconfig') {
            steps {
                sh 'aws eks update-kubeconfig --region us-east-1 --name eks-cluster'
            }
        }
        stage('Run Ansible Playbook') {
            steps {
                dir('ansible') {
                    script {
                        if (params.ACTION == 'deploy') {
                            echo "Running Ansible Deployment with ${params.REPLICAS} replicas..."
                            sh "ansible-playbook deploy.yml -e 'replicas=${params.REPLICAS}'"
                        } else if (params.ACTION == 'remove') {
                            echo "Removing Kubernetes Resources..."
                            sh 'kubectl delete -f manifests/ --ignore-not-found=true || true'
                        }
                    }
                }
            }
        }
    }
}
