
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_NAME',
            defaultValue: 'nginx',
            description: 'Container image repository/name'
        )
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'latest',
            description: 'Container image tag/version'
        )
        string(
            name: 'REPLICAS',
            defaultValue: '2',
            description: 'Number of pod replicas'
        )
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Configure Kubeconfig') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                      --region us-east-1 \
                      --name eks-cluster
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                dir('ansible') {
                    echo "Deploying ${params.IMAGE_NAME}:${params.IMAGE_VERSION}"

                    sh """
                        ansible-playbook deploy.yml \
                          -e 'replicas=${params.REPLICAS}' \
                          -e 'image_name=${params.IMAGE_NAME}' \
                          -e 'image_version=${params.IMAGE_VERSION}'
                    """
                }
            }
        }

        stage('Get Access URL') {
            steps {
                script {
                    def hostname = sh(
                        script: """
                            kubectl get svc application-service \
                              -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
                        """,
                        returnStdout: true
                    ).trim()

                    if (hostname) {
                        echo "Application URL: http://${hostname}"
                    } else {
                        echo 'LoadBalancer is still provisioning.'
                    }
                }
            }
        }
    }
}
