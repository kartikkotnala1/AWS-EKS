pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Create or destroy infrastructure'
        )

        string(
            name: 'REPLICAS',
            defaultValue: '2',
            description: 'Number of NGINX pod replicas'
        )
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION = 'us-east-1'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('terraform') {
                    sh 'terraform init -reconfigure'
                }
            }
        }

        stage('Terraform Action') {
            steps {
                dir('terraform') {
                    script {
                        if (params.ACTION == 'apply') {
                            echo 'Running Terraform Plan...'
                            sh 'terraform plan -out=tfplan'

                            input(
                                message: 'Do you want to apply these changes?',
                                ok: 'Yes, Apply'
                            )

                            sh 'terraform apply tfplan'

                        } else {
                            input(
                                message: 'WARNING: Destroy all Terraform-managed infrastructure?',
                                ok: 'Yes, Destroy'
                            )

                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }

        stage('Configure Kubeconfig') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                sh '''
                    aws eks update-kubeconfig \
                      --region us-east-1 \
                      --name eks-cluster
                '''
            }
        }

        stage('Deploy NGINX') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('ansible') {
                    echo "Deploying NGINX with ${params.REPLICAS} replicas"

                    sh """
                        ansible-playbook deploy.yml \
                          -e 'replicas=${params.REPLICAS}'
                    """
                }
            }
        }

        stage('Get Access URL') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    def hostname = ''

                    for (int i = 0; i < 12; i++) {
                        hostname = sh(
                            script: """
                                kubectl get svc application-service \
                                  -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                                  2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (hostname) {
                            break
                        }

                        sleep(time: 10, unit: 'SECONDS')
                    }

                    if (hostname) {
                        echo "Application URL: http://${hostname}"
                    } else {
                        echo 'LoadBalancer hostname is not available yet. Check the service status.'
                        sh 'kubectl get svc application-service'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}

