
pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Create or destroy infrastructure'
        )

        string(
            name: 'REPLICAS',
            defaultValue: '2',
            description: 'Number of NGINX pod replicas'
        )
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION = 'us-east-1'
    }

    stages {

        // 1. Checkout Code
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        // 2. Terraform Init - Both Apply and Destroy
        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init -reconfigure'
                }
            }
        }

        // 3. Kubernetes Cleanup - Only During Destroy
        stage('Cleanup Kubernetes Resources') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                sh '''
                    if aws eks describe-cluster \
                        --region us-east-1 \
                        --name eks-cluster >/dev/null 2>&1; then

                        echo "EKS cluster exists. Starting Kubernetes cleanup..."

                        aws eks update-kubeconfig \
                            --region us-east-1 \
                            --name eks-cluster

                        echo "Deleting NGINX LoadBalancer Service..."

                        kubectl delete service application-service \
                            --ignore-not-found=true \
                            --wait=true \
                            --timeout=180s

                        echo "Deleting NGINX Deployment..."

                        kubectl delete deployment application-deployment \
                            --ignore-not-found=true \
                            --wait=true \
                            --timeout=180s

                        echo "Kubernetes cleanup commands completed."

                    else
                        echo "EKS cluster does not exist. Skipping Kubernetes cleanup."
                    fi
                '''
            }
        }

        // 4. Terraform Action
        stage('Terraform Action') {
            steps {
                dir('terraform') {
                    script {

                        if (params.ACTION == 'apply') {

                            echo 'Running Terraform Plan...'

                            sh 'terraform plan -out=tfplan'

                            input(
                                message: 'Do you want to apply these changes?',
                                ok: 'Yes, Apply'
                            )

                            sh 'terraform apply tfplan'

                        } else {

                            input(
                                message: 'WARNING: Destroy all Terraform-managed infrastructure?',
                                ok: 'Yes, Destroy'
                            )

                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }

        // 5. Configure Kubeconfig - Only Apply
        stage('Configure Kubeconfig') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region us-east-1 \
                        --name eks-cluster
                '''
            }
        }

        // 6. Deploy NGINX - Only Apply
        stage('Deploy NGINX') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('ansible') {

                    echo "Deploying NGINX with ${params.REPLICAS} replicas"

                    sh """
                        ansible-playbook deploy.yml \
                            -e 'replicas=${params.REPLICAS}'
                    """
                }
            }
        }

        // 7. Get LoadBalancer URL - Only Apply
        stage('Get Access URL') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {

                    def hostname = ''

                    for (int i = 0; i < 12; i++) {

                        hostname = sh(
                            script: """
                                kubectl get svc application-service \
                                    -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                                    2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (hostname) {
                            break
                        }

                        sleep(time: 10, unit: 'SECONDS')
                    }

                    if (hostname) {

                        echo "Application URL: http://${hostname}"

                    } else {

                        echo 'LoadBalancer hostname is not available yet.'

                        sh 'kubectl get svc application-service'
                    }
                }
            }
        }
    }

    post {

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
